{
  // Static site on Cloudflare Workers static assets, deployed by Workers Builds on every push to the default branch.
  "name": "aibg-web",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The dev branch deploys as its own Worker (aibg-web-dev) through Workers Builds, so it can carry a stable hostname.
  "env": {
    "dev": { "name": "aibg-web-dev" }
  }
}
